#!/bin/sh
# aspen configure — tiny capability probe. No autotools. Writes config.h + config.mk.
# Re-run is idempotent. Honors CC, CFLAGS, PREFIX, DESTDIR from the environment.
set -u

CC=${CC:-cc}
PREFIX=${PREFIX:-/usr/local}
tmp=$(mktemp -d 2>/dev/null || echo /tmp/asp.cfg.$$)
mkdir -p "$tmp"
trap 'rm -rf "$tmp"' EXIT

# try_compile <name> <source>  -> echoes 1 if it builds, else 0
try_compile() {
    printf '%s\n' "$2" > "$tmp/t.c"
    if $CC $CFLAGS_PROBE -o "$tmp/t" "$tmp/t.c" $3 >/dev/null 2>&1; then
        echo 1
    else
        echo 0
    fi
}
CFLAGS_PROBE=${CFLAGS:-}

uname_s=$(uname -s)
echo "configure: CC=$CC  OS=$uname_s  PREFIX=$PREFIX"

# glibc under -std=c11 hides POSIX/BSD symbols (S_IFLNK, syscall(), getdents64,
# statx) behind __STRICT_ANSI__; _GNU_SOURCE re-exposes them. BSD/macOS expose
# them by default, so this is Linux-only. Goes on the command line so it is
# defined before any system header in every translation unit.
CONF_CFLAGS=
case "$uname_s" in
Linux) CONF_CFLAGS='-D_GNU_SOURCE' ;;
esac

HAS_GETDENTS64=$(try_compile getdents64 '
#define _GNU_SOURCE
#include <unistd.h>
#include <sys/syscall.h>
int main(void){ char b[1]; return (int)syscall(SYS_getdents64,0,b,1); }' '')

HAS_GETDIRENTRIES=$(try_compile getdirentries '
#include <dirent.h>
int main(void){ char b[1]; long base; return (int)getdirentries(0,b,1,&base); }' '')

# Does struct dirent carry d_type? (Linux/BSD/macOS yes; lets us skip the type
# stat.) macOS has it but does not define _DIRENT_HAVE_D_TYPE, so probe directly.
HAS_D_TYPE=$(try_compile d_type '
#define _GNU_SOURCE
#include <dirent.h>
int main(void){ struct dirent d; return (int)d.d_type; }' '')

HAS_STATX=$(try_compile statx '
#define _GNU_SOURCE
#include <fcntl.h>
#include <sys/stat.h>
int main(void){ struct statx sx; return statx(AT_FDCWD,"",0,0,&sx); }' '')

HAS_LIBURING=$(try_compile liburing '
#include <liburing.h>
int main(void){ struct io_uring r; return io_uring_queue_init(8,&r,0); }' '-luring')

HAS_PTHREAD=$(try_compile pthread '
#include <pthread.h>
int main(void){ return (int)pthread_self()==0; }' '-lpthread')

# We do NOT link -lpthread: the stat pool dlopen()s the thread runtime on demand
# (pool.c), so a serial run pays none of libthr's startup cost (a tiny `-L 1`
# walk would otherwise be slower than tree on FreeBSD). We only need dlopen/dlsym
# — in libc on FreeBSD/musl/macOS and glibc>=2.34, else via -ldl.
NEED_LDL=0
if [ "$(try_compile dl_libc '
#include <dlfcn.h>
int main(void){ return dlopen("",0)!=0; }' '')" != 1 ]; then
	[ "$(try_compile dl_ldl '
#include <dlfcn.h>
int main(void){ return dlopen("",0)!=0; }' '-ldl')" = 1 ] && NEED_LDL=1
fi

# Pick the directory-read backend (Linux: getdents64; BSD/macOS: getdirentries; else readdir)
DIR_BACKEND=readdir
[ "$HAS_GETDIRENTRIES" = 1 ] && DIR_BACKEND=getdirentries
[ "$HAS_GETDENTS64" = 1 ] && DIR_BACKEND=getdents64

cat > config.h <<EOF
/* generated by ./configure — do not edit */
#ifndef ASP_CONFIG_H
#define ASP_CONFIG_H
#define ASP_OS            "$uname_s"
#define ASP_HAS_GETDENTS64    $HAS_GETDENTS64
#define ASP_HAS_GETDIRENTRIES $HAS_GETDIRENTRIES
#define ASP_HAS_D_TYPE        $HAS_D_TYPE
#define ASP_HAS_STATX         $HAS_STATX
#define ASP_HAS_LIBURING      $HAS_LIBURING
#define ASP_HAS_PTHREAD       $HAS_PTHREAD
#define ASP_DIR_BACKEND_${DIR_BACKEND} 1
#endif
EOF

cat > config.mk <<EOF
# generated by ./configure — do not edit
CC = $CC
PREFIX = $PREFIX
CONF_CFLAGS = $CONF_CFLAGS
ASP_HAS_LIBURING = $HAS_LIBURING
ASP_HAS_PTHREAD = $HAS_PTHREAD
EOF
[ "$HAS_LIBURING" = 1 ] && echo 'LDLIBS_OPT += -luring' >> config.mk
[ "$NEED_LDL" = 1 ]     && echo 'LDLIBS_OPT += -ldl' >> config.mk

echo "configure: dir-backend=$DIR_BACKEND statx=$HAS_STATX liburing=$HAS_LIBURING pthread=$HAS_PTHREAD(dlopen) ldl=$NEED_LDL"
echo "configure: wrote config.h, config.mk"
